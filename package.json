{
  "name": "path-of-mercenaries",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --filter @pom/web dev",
    "build": "pnpm --filter @pom/web build",
    "test": "pnpm --filter @pom/engine test",
    "typecheck": "pnpm -r typecheck",
    "check:loc": "node scripts/check_max_file_lines.mjs",
    "dev:worker": "pnpm --filter @pom/worker dev",
    "deploy:worker": "pnpm --filter @pom/worker deploy",
    "deploy:web": "pnpm --filter @pom/web build && npx wrangler pages deploy apps/web/dist --project-name=path-of-mercenaries"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
